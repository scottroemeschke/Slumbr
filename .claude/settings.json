{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(git diff:*)",
      "Bash(gh:*)",
      "Bash(./gradlew:*)",
      "Bash(gradle:*)",
      "Bash(adb:*)",
      "Bash(java:*)",
      "Bash(javac:*)",
      "Bash(kotlin:*)",
      "Bash(sdkmanager:*)",
      "Bash(pwd:*)",
      "Bash(ls:*)",
      "Bash(jq:*)",
      "Bash(which:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(xargs:*)",
      "Bash(ln:*)",

      "mcp__linear-server__list_teams",
      "mcp__linear-server__get_team",
      "mcp__linear-server__list_users",
      "mcp__linear-server__get_user",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__create_issue",
      "mcp__linear-server__update_issue",
      "mcp__linear-server__list_issue_statuses",
      "mcp__linear-server__list_issue_labels",
      "mcp__linear-server__create_issue_label",
      "mcp__linear-server__list_projects",
      "mcp__linear-server__get_project",
      "mcp__linear-server__create_project",
      "mcp__linear-server__update_project",
      "mcp__linear-server__list_project_labels",
      "mcp__linear-server__list_milestones",
      "mcp__linear-server__get_milestone",
      "mcp__linear-server__create_milestone",
      "mcp__linear-server__update_milestone",
      "mcp__linear-server__list_comments",
      "mcp__linear-server__create_comment",
      "mcp__linear-server__list_cycles",
      "mcp__linear-server__list_documents",
      "mcp__linear-server__get_document",
      "mcp__linear-server__create_document",
      "mcp__linear-server__update_document",
      "mcp__linear-server__get_attachment",
      "mcp__linear-server__create_attachment",
      "mcp__linear-server__delete_attachment",
      "mcp__linear-server__extract_images",
      "mcp__linear-server__search_documentation",
      "mcp__linear-server__get_issue_status",
      "mcp__linear-server__list_initiatives",
      "mcp__linear-server__get_initiative",
      "mcp__linear-server__create_initiative",
      "mcp__linear-server__update_initiative",
      "mcp__linear-server__get_status_updates",
      "mcp__linear-server__save_status_update",
      "mcp__linear-server__delete_status_update",

      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",

      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:developer.android.com)",
      "WebFetch(domain:kotlinlang.org)",
      "WebFetch(domain:d.android.com)",
      "WebFetch(domain:cs.android.com)",
      "WebFetch(domain:maven.google.com)",
      "WebFetch(domain:central.sonatype.com)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force :*)",
      "Bash(git push -f :*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh pr merge --admin:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read fp; case \"$fp\" in *.kt|*.kts) which ktlint >/dev/null 2>&1 && ktlint --format \"$fp\" 2>/dev/null;; esac; }"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name // \"Claude\"'); dir=$(echo \"$input\" | jq -r '.workspace.current_dir // \"~\"' | sed \"s|$HOME|~|\"); remaining=$(echo \"$input\" | jq -r '.context_window.remaining_percentage // empty'); total_in=$(echo \"$input\" | jq -r '.context_window.total_input_tokens // 0'); total_out=$(echo \"$input\" | jq -r '.context_window.total_output_tokens // 0'); total=$((total_in + total_out)); total_k=$(awk \"BEGIN {printf \\\"%.1f\\\", $total/1000}\"); style=$(echo \"$input\" | jq -r '.output_style.name // empty'); if [ -n \"$remaining\" ]; then ctx_display=$(printf \"%.0f%%\" \"$remaining\"); else ctx_display=\"-\"; fi; parts=\"$model\"; [ -n \"$style\" ] && parts=\"$parts | $style\"; parts=\"$parts | $dir\"; parts=\"$parts | ctx: $ctx_display remain\"; [ \"$total\" -gt 0 ] && parts=\"$parts | ${total_k}k total\"; printf \"%s\" \"$parts\""
  }
}
